        "label": "Effets actifs",
        "blocks": [
          {
            "text": "Un environnement ou terrain n’applique que les modificateurs consommés par l’action en cours : statistique, surcoût PF, mouvement, perte périodique, magie ou perception."
          }
        ]
      },
