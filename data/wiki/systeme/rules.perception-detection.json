      {
        "label": "Détecter",
        "blocks": [
          {
            "text": "Une cible fournit un profil par sens. Un canal normal autorise la détection ordinaire ; avancé uniquement exige une aptitude adaptée ; bloqué ne peut pas être utilisé."
          }
        ]
      },
      {
        "label": "Profils courants",
        "blocks": [
          {
            "text": "Invisibilité visuelle, silence, absence d’odeur, vol ou protection ésotérique modifient chacun les canaux concernés. Une aptitude peut rouvrir un canal avancé, sans annuler les autres obstacles."
          }
        ]
      },
      {
        "label": "PERC",
        "blocks": [
          {
            "text": "PERC sert de perception générale lorsque l’action le demande. Les sens spécialisés ne font pas partie du budget des douze statistiques de création."
          }
        ]
      }
    ]
